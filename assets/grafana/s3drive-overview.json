      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(s3drive_s3_requests_total{job=~\"$job\",s3drive_outcome=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(s3drive_s3_requests_total{job=~\"$job\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
