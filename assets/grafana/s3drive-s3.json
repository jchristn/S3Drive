          "expr": "histogram_quantile(0.99, sum by (le, s3drive_drive, s3drive_provider) (rate(s3drive_s3_request_duration_seconds_bucket{job=~\"$job\",s3drive_drive=~\"$drive\"}[$__rate_interval])))",
          "legendFormat": "{{s3drive_drive}} ({{s3drive_provider}})",
          "refId": "A",
          "range": true,
