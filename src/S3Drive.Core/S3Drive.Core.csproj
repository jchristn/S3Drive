    <PackageReference Include="Blobject.AmazonS3" Version="5.0.21" />
    <PackageReference Include="DokanNet" Version="2.3.0.3" />
    <PackageReference Include="Padlock" Version="1.0.4" />
    <PackageReference Include="PrettyId" Version="2.0.1" />
    <PackageReference Include="SyslogLogging" Version="2.2.2" />
  </ItemGroup>
</Project>
