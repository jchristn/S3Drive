<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test.Automated - console runner for the shared Touchstone suites in Test.Shared. Also hosts the
    interactive harness modes (mount-test, make-config, send-command) used to drive a
    real Dokan mount and a running agent by hand.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Test.Shared\Test.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Touchstone.Cli" Version="0.2.0" />
  </ItemGroup>

</Project>
